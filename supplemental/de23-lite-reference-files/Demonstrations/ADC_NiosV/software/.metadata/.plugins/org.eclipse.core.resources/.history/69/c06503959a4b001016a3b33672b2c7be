#endif
	}
	return bSuccess;
}


bool I2C::WriteReg8(alt_u16 nRegByteOffset, alt_u8 nValue8){
	bool bSuccess;

	bSuccess = WriteReg8s(nRegByteOffset, 1, &nValue8);

	return bSuccess;
}

