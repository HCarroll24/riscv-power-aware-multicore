	component img_data_mlab is
		port (
			q       : out std_logic_vector(7 downto 0);                     -- dataout
			address : in  std_logic_vector(14 downto 0) := (others => 'X'); -- address
			clock   : in  std_logic                     := 'X'              -- clk
		);
	end component img_data_mlab;

