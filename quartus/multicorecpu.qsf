# DE23-Lite pin assignments for MULTICORECPU
# Locations and I/O standards copied from Terasic golden_top.qsf (Terasic V2.1.0,
# Quartus 25.1.0 Pro). The user manual (Dec 18, 2025) Tables 3-8/3-9 list the wrong
# I/O standards for LEDR (all 1.2-V, not 3.3V) and HEX2[5]..HEX5[6] (1.8-V / 3.3-V,
# not 1.2V); locations in the manual are correct.

# CLOCK (CLOCK0_50 on the board)
set_location_assignment PIN_K43 -to CLK
set_instance_assignment -name IO_STANDARD "1.2-V" -to CLK

# KEY
set_location_assignment PIN_K26 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[0]
set_location_assignment PIN_K27 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[1]
set_location_assignment PIN_BK10 -to KEY[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[2]
set_location_assignment PIN_W12 -to KEY[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[3]

# SW
set_location_assignment PIN_A37 -to SW[0]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[0]
set_location_assignment PIN_B37 -to SW[1]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[1]
set_location_assignment PIN_B26 -to SW[2]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[2]
set_location_assignment PIN_A42 -to SW[3]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[3]
set_location_assignment PIN_K32 -to SW[4]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[4]
set_location_assignment PIN_A26 -to SW[5]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[5]
set_location_assignment PIN_B27 -to SW[6]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[6]
set_location_assignment PIN_A29 -to SW[7]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[7]
set_location_assignment PIN_D32 -to SW[8]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[8]
set_location_assignment PIN_A34 -to SW[9]
set_instance_assignment -name IO_STANDARD "1.2-V" -to SW[9]

# LEDR
